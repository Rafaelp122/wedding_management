{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "rtk-for-opencode"
  ],
  "model": "deepseek/deepseek-v4-flash",
  "small_model": "deepseek/deepseek-v4-flash",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "deepseek/deepseek-v4-flash",
      "temperature": 0.2,
      "permission": {
        "bash": {
          "*": "allow",
          "git push*": "ask"
        },
        "task": {
          "*": "allow"
        },
        "external_directory": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "deepseek/deepseek-v4-flash",
      "temperature": 0.1,
      "permission": {
        "edit": "ask",
        "write": "ask",
        "bash": "ask",
        "task": {
          "*": "allow"
        }
      }
    },
    "reviewer": {
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.1,
      "steps": 10,
      "description": "Agente especializado em Code Review estático com limite de turnos e permissão somente de leitura",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "task": {
          "*": "deny"
        },
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git commit*": "deny",
          "git reset*": "deny",
          "rm *": "deny"
        }
      }
    }
  },
  "lsp": {
    "typescript": {
      "command": ["npx", "typescript-language-server", "--stdio"],
      "disabled": false
    }
  },
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    }
  }
}
